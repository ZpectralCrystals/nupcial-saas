# One SaaS deployment, many isolated accounts/events.
# Required for cloud. Store real values in the host secret manager, never in Git.
NODE_ENV=production
HOST=0.0.0.0
PORT=4173
APP_URL=https://your-domain.example
SESSION_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgres://user:password@host:5432/nupcial
EMAIL_API_URL=https://email-provider.example/send
EMAIL_API_KEY=replace-with-provider-secret
EMAIL_FROM=noreply@your-domain.example

# Billing is separate. Production app only consumes the external contract later.
PAYMENT_PROVIDER=external
PGSSLMODE=require

# Solo para una demo cloud explícita sin cobro: usa PAYMENT_PROVIDER=mock y habilita
# esta bandera. Mantiene NODE_ENV=production, cookies Secure y login demo apagado.
# ALLOW_MOCK_PAYMENTS=true

# Development-only legacy demo login. Ignored as a production login path.
APP_EMAIL=demo@boda.local
APP_PASSWORD=demo123
